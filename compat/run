#!/bin/sh
# notrecall Steam Play compatibility tool runner.
# Launches Windows Steam games using Recall's patched Wine + DXMT runtime while
# reusing stock NotProton's Steamworks bridge (lsteamclient, steam-shim, overlay-shim).
set -e

verb="${1:-}"
shift || true

case "$verb" in
  getcompatpath)
    printf '%s\n' "$STEAM_COMPAT_DATA_PATH"
    exit 0
    ;;
esac

nr_support="$HOME/Library/Application Support/notrecall"
nr_runtime="$nr_support/runtime"
nr_helpers="$nr_support/helpers"
np_support="$HOME/Library/Application Support/notproton"
bridge_src="$np_support/bridge"
tool_dir=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || tool_dir=""

if [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
  mkdir -p "$STEAM_COMPAT_DATA_PATH"
  log="$STEAM_COMPAT_DATA_PATH/notrecall-run.log"
else
  log="/dev/null"
fi
[ -f "$log" ] && [ "$(stat -f %z "$log" 2>/dev/null || echo 0)" -gt 262144 ] && : > "$log" || true

show_alert() {
  [ "$verb" != "run" ] || return 0
  osascript >/dev/null 2>&1 <<APPLESCRIPT || true
display alert "$1" message "$2" as critical
APPLESCRIPT
}

# 1. Verify Recall runtime and NotProton bridge are staged.
WINELOADER="$nr_runtime/bin/wine"
WINESERVER="$nr_runtime/bin/wineserver"
wine_unix="$nr_runtime/lib/wine/x86_64-unix"

if [ ! -x "$WINELOADER" ] || [ ! -x "$WINESERVER" ] || [ ! -d "$wine_unix" ]; then
  echo "=== notrecall runtime missing at $nr_runtime ===" >> "$log" 2>&1 || true
  show_alert "NotRecall runtime not installed" "Run scripts/install.sh from the notrecall project to stage the Recall Wine + DXMT runtime."
  exit 1
fi

if [ ! -d "$bridge_src" ]; then
  echo "=== NotProton bridge missing at $bridge_src ===" >> "$log" 2>&1 || true
  show_alert "NotProton bridge not found" "Install and run NotProton once so its Steamworks bridge is staged in ~/Library/Application Support/notproton/bridge."
  exit 1
fi

export WINELOADER WINESERVER
export WINEARCH="${WINEARCH:-win64}"
export PATH="$nr_runtime/bin:$PATH"
export WINEDLLPATH="$nr_runtime/lib/wine/x86_64-windows:$wine_unix${WINEDLLPATH:+:$WINEDLLPATH}"
export DYLD_FALLBACK_LIBRARY_PATH="$nr_runtime/lib:$wine_unix${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"

if [ -f "$nr_runtime/lib/external/libd3dshared.dylib" ]; then
  export CX_APPLEGPTK_LIBD3DSHARED_PATH="$nr_runtime/lib/external/libd3dshared.dylib"
fi

# 2. Resolve AppID and Steam environment (guarding non-Steam shortcuts >= 2^31).
app_id="${STEAM_COMPAT_APP_ID:-}"
case "$app_id" in ''|0) app_id="${SteamAppId:-}" ;; esac
case "$app_id" in ''|0) app_id=$(basename "${STEAM_COMPAT_DATA_PATH:-0}" 2>/dev/null) ;; esac
case "$app_id" in ''|*[!0-9]*) app_id=0 ;; esac

# Steam gives every non-Steam shortcut a 64-bit game ID ending in 0x02000000.
shortcut_game_id() {
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "${#1}" -le 20 ] || return 1
  high=0
  low="$1"
  if [ "${#1}" -gt 10 ]; then
    high="${1%??????????}"
    low="${1#"$high"}"
  fi
  high="${high#"${high%%[!0]*}"}"
  low="${low#"${low%%[!0]*}"}"
  [ $(( (${high:-0} % 4294967296 * 1410065408 + ${low:-0}) % 4294967296 )) = 33554432 ]
}

case "$verb" in
  waitforexitandrun)
    if shortcut_game_id "${SteamGameId:-}" || [ "$app_id" -ge 2147483648 ] 2>/dev/null; then
      unset SteamAppId || true
    else
      [ -n "${SteamAppId:-}" ] || export SteamAppId="$app_id"
    fi
    [ -n "${SteamGameId:-}" ] || export SteamGameId="$app_id"
    ;;
esac

# 3. Extract target .exe basename for Recall's dynamic env vars.
target="${1:-}"
exe_name=""
if [ -n "${NOTRECALL_MOUSE_EXE:-}" ]; then
  exe_name="$NOTRECALL_MOUSE_EXE"
elif [ "$app_id" = "2357570" ]; then
  # Overwatch on Steam: always bind mouselook & GPU-lost exit to Overwatch.exe
  # even if Steam launches through a bootstrapper or wrapper executable.
  exe_name="Overwatch.exe"
elif [ -n "$target" ]; then
  exe_name=$(printf '%s' "$target" | sed -e 's|.*[/\\]||')
fi

is_overwatch_launch() {
  [ "$app_id" = "2357570" ] && return 0
  case "$exe_name" in
    [Oo][Vv][Ee][Rr][Ww][Aa][Tt][Cc][Hh].[Ee][Xx][Ee]) return 0 ;;
  esac
  return 1
}

{
  echo "=== notrecall run $(date) ==="
  echo "verb=$verb app_id=$app_id exe=${exe_name:-unknown}"
  echo "runtime=$nr_runtime"
  echo "STEAM_COMPAT_DATA_PATH=${STEAM_COMPAT_DATA_PATH:-}"
  echo "STEAM_COMPAT_INSTALL_PATH=${STEAM_COMPAT_INSTALL_PATH:-}"
} >> "$log" 2>&1 || true

# 4. Prepare per-game Wine prefix (Proton steamuser + Steam Cloud legacy symlinks + S: drive).
lay_out_proton_profile() {
  users="$WINEPREFIX/drive_c/users"
  profile="$users/steamuser"
  mkdir -p "$profile/Documents" "$profile/Desktop" "$profile/Downloads" \
    "$profile/Music" "$profile/Pictures" "$profile/Videos" \
    "$profile/AppData/Local" "$profile/AppData/Roaming" \
    "$profile/Local Settings" 2>/dev/null || true
  [ -e "$profile/My Documents" ] || [ -L "$profile/My Documents" ] || \
    ln -s "./Documents" "$profile/My Documents" 2>/dev/null || true
  [ -e "$profile/Application Data" ] || [ -L "$profile/Application Data" ] || \
    ln -s "./AppData/Roaming" "$profile/Application Data" 2>/dev/null || true
  [ -e "$profile/Local Settings/Application Data" ] || [ -L "$profile/Local Settings/Application Data" ] || \
    ln -s "../AppData/Local" "$profile/Local Settings/Application Data" 2>/dev/null || true
  [ -e "$users/crossover" ] || [ -L "$users/crossover" ] || \
    ln -s steamuser "$users/crossover" 2>/dev/null || true
}

map_game_drive() {
  [ -n "${STEAM_COMPAT_INSTALL_PATH:-}" ] || return 0
  drive="$WINEPREFIX/dosdevices/s:"
  [ -d "$WINEPREFIX/dosdevices" ] || return 0
  library=""
  set -f
  old_ifs=$IFS; IFS=:
  for p in ${STEAM_COMPAT_LIBRARY_PATHS:-}; do
    p=${p%/}
    [ -n "$p" ] || continue
    case "$STEAM_COMPAT_INSTALL_PATH/" in
      "$p"/*) [ "${#p}" -gt "${#library}" ] && library="$p" ;;
    esac
  done
  IFS=$old_ifs
  set +f
  [ -n "$library" ] || return 0
  if [ -L "$drive" ]; then
    [ "$(readlink "$drive" 2>/dev/null || true)" = "$library" ] || ln -sfn "$library" "$drive" 2>/dev/null || true
  elif [ ! -e "$drive" ]; then
    ln -s "$library" "$drive" 2>/dev/null || true
  fi
}

link_fonts() {
  [ -f "$WINEPREFIX/system.reg" ] || return 0
  fonts_dir="$WINEPREFIX/drive_c/windows/Fonts"
  mkdir -p "$fonts_dir" 2>/dev/null || return 0
  for dir in "$np_support/fonts" "$nr_runtime/share/wine/fonts"; do
    [ -d "$dir" ] || continue
    for src in "$dir"/*.ttf "$dir"/*.ttc; do
      [ -f "$src" ] || continue
      dst="$fonts_dir/${src##*/}"
      [ -e "$dst" ] || [ -L "$dst" ] || ln -s "$src" "$dst" 2>/dev/null || true
    done
  done
}

# Symlink Overwatch's Highlights folder to ~/Movies/Overwatch, migrating any existing clips safely.
link_overwatch_highlights() {
  is_overwatch_launch || return 0
  [ -n "${WINEPREFIX:-}" ] || return 0
  hl_target="$HOME/Movies/Overwatch"
  hl_videos="$WINEPREFIX/drive_c/users/steamuser/Documents/Overwatch/videos"
  hl_link="$hl_videos/overwatch"
  mkdir -p "$hl_target" 2>/dev/null || return 0
  if [ -L "$hl_link" ]; then
    [ "$(readlink "$hl_link" 2>/dev/null || true)" = "$hl_target" ] && return 0
    rm -f "$hl_link" 2>/dev/null || return 0
  elif [ -d "$hl_link" ]; then
    rm -f "$hl_link/.DS_Store" 2>/dev/null || true
    for clip in "$hl_link"/* "$hl_link"/.[!.]* "$hl_link"/..?*; do
      [ -e "$clip" ] || [ -L "$clip" ] || continue
      base="${clip##*/}"
      dst="$hl_target/$base"
      if [ -e "$dst" ] || [ -L "$dst" ]; then
        stem="${base%.*}"
        ext="${base##*.}"
        n=2
        while :; do
          if [ "$stem" != "$base" ] && [ -n "$ext" ]; then
            dst="$hl_target/$stem $n.$ext"
          else
            dst="$hl_target/$base $n"
          fi
          [ ! -e "$dst" ] && [ ! -L "$dst" ] && break
          n=$((n + 1))
        done
      fi
      mv -- "$clip" "$dst" 2>/dev/null || return 0
    done
    rmdir "$hl_link" 2>/dev/null || return 0
  elif [ -e "$hl_link" ]; then
    return 0
  else
    mkdir -p "$hl_videos" 2>/dev/null || return 0
  fi
  ln -s "$hl_target" "$hl_link" 2>/dev/null || true
}

# Detect Microsoft native VC++ runtime DLLs installed in system32 so Wine prefers them.
native_vc_runtime() {
  for name in concrt140 msvcp140 msvcp140_1 msvcp140_2 msvcp140_atomic_wait msvcp140_codecvt_ids \
    vcamp140 vccorlib140 vcomp140 vcruntime140 vcruntime140_1; do
    dll="$WINEPREFIX/drive_c/windows/system32/$name.dll"
    [ -f "$dll" ] || continue
    if [ "$(dd if="$dll" bs=1 skip=64 count=16 2>/dev/null)" != "Wine builtin DLL" ]; then
      printf '%s=n,b;' "$name"
    fi
  done
}

# Hide Steam-Input-managed controllers & Switch pads from WineBus hidraw to prevent double input.
controller_ids() {
  printf '%s\n' "$1" | tr ',' '\n' | tr 'A-F' 'a-f' \
    | sed -n 's/^[[:space:]]*0x\([0-9a-f]\{4\}\)\/0x\([0-9a-f]\{4\}\)[[:space:]]*$/\1\/\2/p' \
    | sort -u
}

ids_without() {
  printf '%s\n' "$2" -- "$1" \
    | awk '$0 == "--" { s = 1; next } !s { b[$0]; next } $0 != "" && !($0 in b)'
}

# Emit registry entries to route Wine's default microphone to the Mac's built-in mic
# when a Bluetooth headset is the macOS default input (prevents HFP audio drop).
emit_bt_voice_reg() {
  bt_uid=""
  if [ "${NOTRECALL_BT_MIC_FIX:-1}" != "0" ]; then
    if [ -n "${NOTRECALL_TEST_BT_MIC_UID:-}" ]; then
      [ "$NOTRECALL_TEST_BT_MIC_UID" != "none" ] && bt_uid="$NOTRECALL_TEST_BT_MIC_UID"
    elif [ -x "$nr_helpers/notrecall-sysinfo" ]; then
      bt_uid=$("$nr_helpers/notrecall-sysinfo" bt-voice-uid 2>/dev/null || true)
    fi
  fi
  if [ -n "$bt_uid" ] && [ -x /usr/bin/perl ]; then
    /usr/bin/perl -MDigest::SHA=sha256 -e '
      my ($user_reg, $uid) = @ARGV;
      exit 1 if $uid !~ /^[A-Za-z0-9._:,-]{1,128}$/;
      my @bytes;
      if (-f $user_reg && (-s $user_reg) <= 8*1024*1024 && open my $fh, "<:raw", $user_reg) {
        my $target = "[software\\\\wine\\\\drivers\\\\winecoreaudio.drv\\\\devices\\\\1," . lc($uid) . "]";
        my $in_sec = 0;
        while (my $line = <$fh>) {
          $line =~ s/^\s+|\s+$//g;
          if ($line =~ /^\[/) {
            $in_sec = (index(lc($line), $target) == 0);
            next;
          }
          if ($in_sec && $line =~ /^"guid"=hex:([0-9a-fA-F,]+)$/) {
            my @parts = split(/,/, $1);
            if (@parts == 16 && !grep { $_ !~ /^[0-9a-fA-F]{2}$/ } @parts) {
              @bytes = map { hex($_) } @parts;
              last;
            }
          }
        }
        close $fh;
      }
      if (@bytes != 16) {
        @bytes = unpack("C16", substr(sha256("notrecall-bt-mic|" . $uid), 0, 16));
      }
      my $hex = join(",", map { sprintf("%02x", $_) } @bytes);
      my $d1 = $bytes[0] | ($bytes[1] << 8) | ($bytes[2] << 16) | ($bytes[3] << 24);
      my $d2 = $bytes[4] | ($bytes[5] << 8);
      my $d3 = $bytes[6] | ($bytes[7] << 8);
      my $ep = sprintf("{0.0.1.00000000}.{%08X-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}",
        $d1, $d2, $d3, @bytes[8..15]);
      print "[HKEY_CURRENT_USER\\Software\\Wine\\Drivers\\winecoreaudio.drv\\devices\\1,$uid]\r\n";
      print "\"guid\"=hex:$hex\r\n\r\n";
      print "[HKEY_CURRENT_USER\\Software\\Wine\\Drivers\\winecoreaudio.drv]\r\n";
      print "\"DefaultInput\"=\"$ep\"\r\n";
      print "\"DefaultVoiceInput\"=\"$ep\"\r\n\r\n";
    ' "$WINEPREFIX/user.reg" "$bt_uid" 2>/dev/null && return 0
  fi
  printf '%s\r\n' \
    '[HKEY_CURRENT_USER\Software\Wine\Drivers\winecoreaudio.drv]' \
    '"DefaultInput"=-' \
    '"DefaultVoiceInput"=-' ''
}

import_prefix_settings() {
  [ -f "$WINEPREFIX/system.reg" ] || return 0
  controllers_file="$STEAM_COMPAT_DATA_PATH/notrecall-hidden-controllers"
  owned=""
  [ ! -f "$controllers_file" ] || owned=$(sed -n '/^[0-9a-f]\{4\}\/[0-9a-f]\{4\}$/p' "$controllers_file")

  wanted=""
  if [ "${NOTRECALL_RAW_CONTROLLERS:-0}" != "1" ]; then
    wanted=$(ids_without "$(controller_ids "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}")" \
      "$(controller_ids "${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-}")")
    wanted=$(printf '%s\n' "$wanted" 057e/2006 057e/2007 057e/2009 | sed '/^$/d' | sort -u)
    # Steam install scripts (verb=run) receive no ignore list; preserve existing hidden set.
    if [ "$verb" = "run" ]; then
      wanted=$(printf '%s\n' "$wanted" "$owned" | sed '/^$/d' | sort -u)
    fi
  fi
  removed=$(ids_without "$owned" "$wanted")

  retina_mode="Y"
  display_scale="${NOTRECALL_TEST_DISPLAY_SCALE:-}"
  if [ -z "$display_scale" ] && [ -x "$nr_helpers/notrecall-sysinfo" ]; then
    display_scale=$("$nr_helpers/notrecall-sysinfo" display-scale 2>/dev/null || true)
  fi
  [ "$display_scale" = "1" ] && retina_mode="N"

  reg_file=$(mktemp "$WINEPREFIX/drive_c/notrecall-settings.XXXXXX" 2>/dev/null) || return 0
  {
    printf '%s\r\n' \
      'Windows Registry Editor Version 5.00' '' \
      '[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\AeDebug]' '"Auto"="0"' '' \
      '[HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\AeDebug]' '"Auto"="0"' '' \
      '[HKEY_CURRENT_USER\Software\Wine\WineDbg]' '"ShowCrashDialog"=dword:00000000' '' \
      '[HKEY_LOCAL_MACHINE\Software\Classes\steam]' '"URL Protocol"=""' '' \
      '[HKEY_LOCAL_MACHINE\Software\Classes\steam\shell\open\command]' \
      '@="\"C:\\Program Files (x86)\\Steam\\steam.exe\" \"%1\""' '' \
      '[HKEY_CURRENT_USER\Software\Wine\Mac Driver]' \
      "\"RetinaMode\"=\"$retina_mode\"" '' \
      '[HKEY_CURRENT_USER\Software\Wine\WineBrowser]' \
      '"Browsers"="/usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/open"' \
      '"Mailers"="/usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/open"' '' \
      '[HKEY_CURRENT_USER\Software\Wine\AppDefaults\Overwatch.exe\Mac Driver]' \
      '"LeftOptionIsAlt"="Y"' ''

    # Match Recall's direct network connection default (disables WPAD auto-proxy
    # detection so WinHTTP/WinInet don't stall 60s on wildcard-DNS ISPs).
    if [ "${NOTRECALL_PROXY_AUTO_DETECT:-0}" = "1" ]; then
      printf '%s\r\n' \
        '[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings\Connections]' \
        '"DefaultConnectionSettings"=-' ''
    else
      printf '%s\r\n' \
        '[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings\Connections]' \
        '"DefaultConnectionSettings"=hex:46,00,00,00,01,00,00,00,01,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00' ''
    fi

    emit_bt_voice_reg

    printf '%s\n' "$wanted" | while IFS= read -r cid; do
      [ -n "$cid" ] || continue
      printf '%s\r\n' \
        "[HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Services\\WineBus\\Devices\\$cid]" \
        '"Hidraw"=dword:00000000' ''
    done
    printf '%s\n' "$removed" | while IFS= read -r cid; do
      [ -n "$cid" ] || continue
      printf '%s\r\n' \
        "[-HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Services\\WineBus\\Devices\\$cid]" ''
    done
  } > "$reg_file" 2>/dev/null

  # Only run reg import (and restart wineserver) when settings actually changed.
  reg_sha=$(/usr/bin/shasum -a 256 "$reg_file" 2>/dev/null | cut -d' ' -f1)
  stamp_file="$STEAM_COMPAT_DATA_PATH/.notrecall-reg.sha"
  if [ -n "$reg_sha" ] && [ "$(cat "$stamp_file" 2>/dev/null || true)" = "$reg_sha" ]; then
    echo "=== prefix settings unchanged, skipping reg import ===" >> "$log" 2>&1 || true
  else
    if without_lock_fds "$WINELOADER" reg import "C:\\${reg_file##*/}" >> "$log" 2>&1; then
      printf '%s\n' "$reg_sha" > "$stamp_file" 2>/dev/null || true
      printf '%s\n' "$wanted" | sed '/^$/d' | sort -u > "$controllers_file.new" 2>/dev/null && \
        mv -f "$controllers_file.new" "$controllers_file" 2>/dev/null || rm -f "$controllers_file.new"
      without_lock_fds "$WINESERVER" -k >> "$log" 2>&1 || true
      without_lock_fds "$WINESERVER" -w >> "$log" 2>&1 || true
    fi
  fi
  rm -f "$reg_file"
}

# Keeps Wine/wineserver from inheriting the per-prefix lock FD.
without_lock_fds() {
  "$@" 8>&-
}

prefix_locked=0
if [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
  prefix_lock="$STEAM_COMPAT_DATA_PATH/.notrecall-prefix.lock"
  if [ ! -L "$prefix_lock" ] && { [ ! -e "$prefix_lock" ] || [ -f "$prefix_lock" ]; }; then
    if exec 8>> "$prefix_lock" 2>/dev/null; then
      if /usr/bin/lockf -s -t 60 8 2>/dev/null; then
        prefix_locked=1
      else
        echo "=== prefix lock busy after 60s, continuing without lock ===" >> "$log" 2>&1 || true
        exec 8>&-
      fi
    fi
  fi
  export WINEPREFIX="$STEAM_COMPAT_DATA_PATH/pfx"
  mkdir -p "$WINEPREFIX"
  lay_out_proton_profile
  if [ ! -f "$WINEPREFIX/system.reg" ]; then
    echo "=== initializing new prefix at $WINEPREFIX ===" >> "$log" 2>&1 || true
    without_lock_fds "$WINELOADER" wineboot --init >> "$log" 2>&1 || true
    without_lock_fds "$WINESERVER" -w >> "$log" 2>&1 || true
  fi
  map_game_drive
  import_prefix_settings
  link_fonts
  link_overwatch_highlights
fi

# 5. Stage NotProton's Steamworks bridge and legacycompat into the prefix & Steam client.
prefix_steam="$WINEPREFIX/drive_c/Program Files (x86)/Steam"
bridge_files="steamclient64.dll steamclient.dll tier0_s64.dll vstdlib_s64.dll lsteamclient.dll lsteamclient.so steam.exe"

if [ -n "${WINEPREFIX:-}" ]; then
  mkdir -p "$prefix_steam" "$WINEPREFIX/drive_c/windows/system32/config" 2>/dev/null || true
  for f in $bridge_files; do
    src="$bridge_src/$f"
    [ "$f" = "lsteamclient.so" ] && src="$bridge_src/x86_64-unix/$f"
    [ -f "$src" ] || continue
    cmp -s "$src" "$prefix_steam/$f" 2>/dev/null || cp -c -fp "$src" "$prefix_steam/$f" 2>/dev/null || cp -fp "$src" "$prefix_steam/$f"
  done
  if [ -f "$bridge_src/i386-windows/lsteamclient.dll" ] && [ -d "$WINEPREFIX/drive_c/windows/syswow64" ]; then
    cmp -s "$bridge_src/i386-windows/lsteamclient.dll" "$WINEPREFIX/drive_c/windows/syswow64/lsteamclient.dll" 2>/dev/null || \
      cp -fp "$bridge_src/i386-windows/lsteamclient.dll" "$WINEPREFIX/drive_c/windows/syswow64/lsteamclient.dll"
  fi
  if [ -f "$bridge_src/legacycompat/Steam.dll" ] && [ -d "$WINEPREFIX/drive_c/windows/syswow64" ]; then
    cmp -s "$bridge_src/legacycompat/Steam.dll" "$WINEPREFIX/drive_c/windows/syswow64/Steam.dll" 2>/dev/null || \
      cp -fp "$bridge_src/legacycompat/Steam.dll" "$WINEPREFIX/drive_c/windows/syswow64/Steam.dll"
  fi
  export WINEDLLPATH="$prefix_steam:$WINEDLLPATH"
  if [ -z "${STEAM_COMPAT_CLIENT_INSTALL_PATH:-}" ]; then
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/Library/Application Support/Steam/Steam.AppBundle/Steam/Contents/MacOS"
  fi
  # Stage legacycompat evaluators & Steam.dll symlink for older Steam games.
  if [ -d "$bridge_src/legacycompat" ] && [ -n "$STEAM_COMPAT_CLIENT_INSTALL_PATH" ]; then
    mkdir -p "$STEAM_COMPAT_CLIENT_INSTALL_PATH/legacycompat" 2>/dev/null || true
    for f in "$bridge_src/legacycompat"/*; do
      [ -f "$f" ] || continue
      dst="$STEAM_COMPAT_CLIENT_INSTALL_PATH/legacycompat/${f##*/}"
      cmp -s "$f" "$dst" 2>/dev/null || cp -c -f "$f" "$dst" 2>/dev/null || cp -f "$f" "$dst" 2>/dev/null || true
    done
    legacy_dll="$STEAM_COMPAT_CLIENT_INSTALL_PATH/legacycompat/Steam.dll"
    if [ -n "${STEAM_COMPAT_INSTALL_PATH:-}" ] && [ -f "$legacy_dll" ]; then
      link_dst="$(dirname "$STEAM_COMPAT_INSTALL_PATH")/Steam.dll"
      [ -e "$link_dst" ] || [ -L "$link_dst" ] || { ln -sfn "$legacy_dll" "$link_dst" 2>/dev/null && chflags -h hidden "$link_dst" 2>/dev/null || true; }
    fi
  fi
fi

# 6. Configure Recall's DXMT, MetalFX, mouse, and shader cache settings.
export CX_GRAPHICS_BACKEND="dxmt"
export CX_ACTIVE_GRAPHICS_BACKEND="dxmt"
export CX_HACK_FILESYSTEM_TYPE="${CX_HACK_FILESYSTEM_TYPE:-1}"
export ROSETTA_ADVERTISE_AVX="${ROSETTA_ADVERTISE_AVX:-1}"
export WINE_SIMULATE_WRITECOPY="${WINE_SIMULATE_WRITECOPY:-1}"
export WINEMSYNC="${WINEMSYNC:-1}"
export WINEESYNC="${WINEESYNC:-0}"
export DXMT_CANVAS_DRAWABLES="${DXMT_CANVAS_DRAWABLES:-3}"
export DXMT_CANVAS_OVERLAY="${DXMT_CANVAS_OVERLAY:-0}"
export DXMT_USE_DEFAULT_METAL_CACHE="${DXMT_USE_DEFAULT_METAL_CACHE:-1}"
export DXMT_PREPARE_SHADERS="${DXMT_PREPARE_SHADERS:-1}"
export DXMT_PIPELINE_CACHE_PREFER_EXPENSIVE="${DXMT_PIPELINE_CACHE_PREFER_EXPENSIVE:-1}"
export DXMT_PIPELINE_CACHE_PREWARM_LIMIT="${DXMT_PIPELINE_CACHE_PREWARM_LIMIT:-128}"
export DXMT_PIPELINE_CACHE_PREWARM_MS="${DXMT_PIPELINE_CACHE_PREWARM_MS:-10000}"
export DXMT_METALFX_GPU_AFTER_HANG="${DXMT_METALFX_GPU_AFTER_HANG:-1}"
export DXMT_GPU_ERROR_DETAIL="${DXMT_GPU_ERROR_DETAIL:-1}"
if [ "${NOTRECALL_LOG_GRAPHICS:-0}" = "1" ]; then
  export DXMT_LOG_LEVEL="${DXMT_LOG_LEVEL:-info}"
  if [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
    mkdir -p "$STEAM_COMPAT_DATA_PATH/dxmt-logs" 2>/dev/null || true
    export DXMT_LOG_PATH="${DXMT_LOG_PATH:-$STEAM_COMPAT_DATA_PATH/dxmt-logs}"
  else
    export DXMT_LOG_PATH="${DXMT_LOG_PATH:-none}"
  fi
else
  export DXMT_LOG_LEVEL="${DXMT_LOG_LEVEL:-error}"
  export DXMT_LOG_PATH="${DXMT_LOG_PATH:-none}"
fi
[ -n "$exe_name" ] && export DXMT_GPU_LOST_EXIT="${DXMT_GPU_LOST_EXIT:-$exe_name}"
if [ "${NOTRECALL_LOG_CRASHES:-0}" = "1" ] && [ -z "${WINEDEBUG:-}" ]; then
  export WINEDEBUG="-all,err+all,+seh,+loaddll,+timestamp,+pid"
else
  export WINEDEBUG="${WINEDEBUG:--all}"
fi
if [ "${NOTRECALL_LOG_MOUSE:-0}" = "1" ] && [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
  mkdir -p "$STEAM_COMPAT_DATA_PATH/input-logs" 2>/dev/null || true
  export WINEMAC_INPUT_STATS="${WINEMAC_INPUT_STATS:-$STEAM_COMPAT_DATA_PATH/input-logs}"
fi
if [ "${MTL_HUD_ENABLED:-0}" = "1" ]; then
  export MTL_HUD_DISABLE_MENU_BAR="${MTL_HUD_DISABLE_MENU_BAR:-1}"
  export MTL_HUD_ELEMENTS="${MTL_HUD_ELEMENTS:-device,rosetta,layersize,memory,gamemode,fps,gputime,frameinterval,frameintervalgraph,shaders}"
fi

# Windows-side DXMT expects DXMT_CONFIG_FILE as a Windows Z:\... path.
# For Overwatch (AppID 2357570 / Overwatch.exe), generate Recall's tuned DXMT
# profile (8 normal-priority compiler threads, maxFrameLatency=1, nativeFullscreen,
# sharpPresentation, A-series displaySyncEnabled) and merge any user dxmt.conf last.
posix_to_winpath() {
  printf 'Z:%s' "$1" | tr '/' '\\'
}


# Seed Overwatch's Settings_v0.ini with Recall's baseline & per-display resolution/refresh
# memory + fit-to-screen clamping (matching Recall's portable_preferences.h).
# Remembers each display's resolution & refresh rate in notrecall-display.json, clamps
# oversized resolutions to fit the current main display, and keeps dxmt.conf in sync.
ow_canvas_w=""
ow_canvas_h=""
seed_overwatch_preferences() {
  is_overwatch_launch || return 0
  [ -n "${WINEPREFIX:-}" ] && [ -n "${STEAM_COMPAT_DATA_PATH:-}" ] || return 0
  [ -x /usr/bin/perl ] || return 0

  screen_id="default"
  def_w=1920; def_h=1200; def_hz=120; max_w=16384; max_h=16384
  if [ -n "${NOTRECALL_TEST_DISPLAY_INFO:-}" ]; then
    set -- $NOTRECALL_TEST_DISPLAY_INFO
    screen_id="${1:-default}"; def_w="${2:-1920}"; def_h="${3:-1200}"
    def_hz="${4:-120}"; max_w="${5:-16384}"; max_h="${6:-16384}"
  elif [ -n "${NOTRECALL_TEST_DISPLAY_DEFAULT:-}" ]; then
    set -- $NOTRECALL_TEST_DISPLAY_DEFAULT
    def_w="${1:-1920}"; def_h="${2:-1200}"; def_hz="${3:-120}"
  elif [ -x "$nr_helpers/notrecall-sysinfo" ]; then
    info=$("$nr_helpers/notrecall-sysinfo" display-info 2>/dev/null || true)
    if [ -n "$info" ]; then
      set -- $info
      screen_id="${1:-default}"; def_w="${2:-1920}"; def_h="${3:-1200}"
      def_hz="${4:-120}"; max_w="${5:-16384}"; max_h="${6:-16384}"
    fi
  fi
  case "$def_w" in ''|*[!0-9]*) def_w=1920 ;; esac
  case "$def_h" in ''|*[!0-9]*) def_h=1200 ;; esac
  case "$def_hz" in ''|*[!0-9]*) def_hz=120 ;; esac
  case "$max_w" in ''|*[!0-9]*) max_w=16384 ;; esac
  case "$max_h" in ''|*[!0-9]*) max_h=16384 ;; esac

  settings_dir="$WINEPREFIX/drive_c/users/steamuser/Documents/Overwatch/Settings"
  settings_ini="$settings_dir/Settings_v0.ini"
  state_file="$STEAM_COMPAT_DATA_PATH/notrecall-display.state"
  seed_marker="$STEAM_COMPAT_DATA_PATH/.notrecall-ow-baseline-seeded"
  backup_ini="$STEAM_COMPAT_DATA_PATH/Settings_v0.before-baseline.ini"
  mkdir -p "$settings_dir" 2>/dev/null || return 0

  if [ ! -L "$settings_ini" ]; then
    dims=$(/usr/bin/perl -e '
      my ($path, $backup, $state_path, $seed_marker, $screen, $def_w, $def_h, $def_hz, $max_w, $max_h) = @ARGV;
      my %displays;
      my ($last_screen, $last_w, $last_h, $last_hz, $last_gpu, $seeded) = ("", 0, 0, 0, "", (-f $seed_marker ? 1 : 0));
      if (-f $state_path && open my $sf, "<:raw", $state_path) {
        while (my $line = <$sf>) {
          chomp $line;
          if ($line =~ /^display\t([^\t]+)\t([0-9]+)\t([0-9]+)\t([0-9]+)$/) {
            $displays{$1} = [$2 + 0, $3 + 0, $4 + 0];
          } elsif ($line =~ /^last\t([^\t]*)\t([0-9]+)\t([0-9]+)\t([0-9]+)\t(.*)$/) {
            ($last_screen, $last_w, $last_h, $last_hz, $last_gpu) = ($1, $2 + 0, $3 + 0, $4 + 0, $5);
          } elsif ($line eq "seeded\t1") {
            $seeded = 1;
          }
        }
        close $sf;
      }

      my $orig = "";
      my $existed = (-f $path);
      if ($existed) {
        my $size = -s $path;
        exit 0 if !defined $size || $size > 1048576;
        open my $in, "<:raw", $path or exit 0;
        local $/;
        $orig = <$in>;
        close $in;
        $orig = "" if !defined $orig;
      }
      my $nl = ($orig =~ /\r\n/) ? "\r\n" : "\n";
      my @lines = length($orig) ? split(/\Q$nl\E/, $orig, -1) : ("[Render.13]", "");

      my $get_val = sub {
        my ($sec_prefix, $key) = @_;
        my $in = 0;
        for my $raw (@lines) {
          (my $t = $raw) =~ s/^\s+|\s+$//g;
          if ($t =~ /^\[/) { $in = (index($t, $sec_prefix) == 0); next; }
          next unless $in;
          if ($t =~ /^\Q$key\E\s*=\s*"?([^"]*)"?$/) { return $1; }
        }
        return undef;
      };

      my $cur_gpu = ($get_val->("[GPU.", "GPUName") // "") . "|" . ($get_val->("[GPU.", "GPUVenderID") // "");
      my $cur_w   = $get_val->("[Render.13]", "FullScreenWidth");
      my $cur_h   = $get_val->("[Render.13]", "FullScreenHeight");
      my $cur_hz  = $get_val->("[Render.13]", "FullScreenRefresh");

      # If player changed resolution or refresh in-game (same GPU), save it for last_screen.
      if ($seeded && $last_screen ne "" && $last_w > 0 && $last_h > 0 && $cur_gpu eq $last_gpu) {
        my $gw = (defined $cur_w && $cur_w =~ /^[0-9]{3,5}$/ && $cur_w >= 640 && $cur_w <= 16384) ? $cur_w + 0 : 0;
        my $gh = (defined $cur_h && $cur_h =~ /^[0-9]{3,5}$/ && $cur_h >= 480 && $cur_h <= 16384) ? $cur_h + 0 : 0;
        my $ghz = (defined $cur_hz && $cur_hz =~ /^[0-9]{2,3}$/ && $cur_hz >= 24) ? $cur_hz + 0 : ($displays{$last_screen} ? $displays{$last_screen}[2] : $last_hz);
        if ($gw && $gh && ($gw != $last_w || $gh != $last_h || ($ghz && $ghz != $last_hz))) {
          $displays{$last_screen} = [$gw, $gh, $ghz || $def_hz];
        }
      }

      my ($want_w, $want_h, $want_hz) = $displays{$screen} ? @{$displays{$screen}} : ($def_w + 0, $def_h + 0, $def_hz + 0);
      $displays{$screen} = [$want_w, $want_h, $want_hz];

      # Recall fitResolution(): clamp oversized resolutions to fit the current display in Wine.
      my ($game_w, $game_h) = ($want_w, $want_h);
      if ($game_w > $max_w || $game_h > $max_h) {
        my @opts = ([1920,1080],[1920,1200],[2560,1440],[2560,1600],[3840,2160],[3840,2400]);
        my ($bw, $bh) = (0, 0);
        for my $same_shape (1, 0) {
          last if $bw;
          for my $o (@opts) {
            my ($ow, $oh) = @$o;
            next if $ow > $max_w || $oh > $max_h;
            next if $same_shape && ($ow * $want_h != $oh * $want_w);
            if ($ow * $oh > $bw * $bh) { ($bw, $bh) = ($ow, $oh); }
          }
        }
        ($game_w, $game_h) = ($bw, $bh) if $bw;
      }

      my ($rs, $re) = (-1, scalar(@lines));
      for my $i (0 .. $#lines) {
        (my $t = $lines[$i]) =~ s/^\s+|\s+$//g;
        if ($rs < 0 && $t eq "[Render.13]") { $rs = $i + 1; }
        elsif ($rs >= 0 && $t =~ /^\[/) { $re = $i; last; }
      }
      if ($rs < 0) {
        push @lines, "" if @lines && $lines[-1] ne "";
        push @lines, "[Render.13]";
        $rs = scalar(@lines);
        $re = $rs;
      }
      my $find_key = sub {
        my ($s, $e, $key) = @_;
        for my $i ($s .. $e - 1) {
          (my $t = $lines[$i]) =~ s/^\s+|\s+$//g;
          return $i if $t =~ /^\Q$key\E\s*=/;
        }
        return -1;
      };
      my $last = $rs;
      for my $i ($rs .. $re - 1) { $last = $i + 1 if $lines[$i] =~ /\S/; }
      my $changed = !$existed;
      my $set_key = sub {
        my ($k, $v, $only_missing) = @_;
        my $idx = $find_key->($rs, $re, $k);
        return if $only_missing && $idx >= 0;
        my $line = "$k = \"$v\"";
        if ($idx >= 0) {
          if ($lines[$idx] ne $line) { $lines[$idx] = $line; $changed = 1; }
        } else {
          splice(@lines, $last, 0, $line);
          $last++; $re++; $changed = 1;
        }
      };

      if (!$seeded || !$existed) {
        my %launch = (
          UseCustomWorldScale     => "1",
          DynamicRenderScale      => "0",
          FullscreenWindow        => "0",
          FullscreenWindowEnabled => "0",
          WindowedFullscreen      => "0",
          WindowMode              => "0",
          FullScreenWidth         => $game_w,
          FullScreenHeight        => $game_h,
          FullScreenRefresh       => $want_hz,
          WindowedWidth           => $game_w,
          WindowedHeight          => $game_h,
          WindowedPosX            => "100",
          WindowedPosY            => "100",
        );
        my %baseline = (
          FrameRateCap        => "600",
          UseCustomFrameRates => "1",
          GFXPresetLevel      => "1",
          PhysicsQuality      => "3",
          VerticalSyncEnabled => "0",
          ShowFPSCounter      => "1",
          ShowRTT             => "1",
          WindowedRefresh     => $want_hz,
        );
        for my $k (sort keys %launch)   { $set_key->($k, $launch{$k}, 0); }
        for my $k (sort keys %baseline) { $set_key->($k, $baseline{$k}, 1); }
      } else {
        # Always enforce fitted per-display resolution/refresh and clamp WindowedWidth/Height.
        $set_key->("FullScreenWidth",   $game_w, 0);
        $set_key->("FullScreenHeight",  $game_h, 0);
        $set_key->("FullScreenRefresh", $want_hz, 0);
        my $ww = $get_val->("[Render.13]", "WindowedWidth");
        my $wh = $get_val->("[Render.13]", "WindowedHeight");
        if (!defined $ww || $ww !~ /^[0-9]+$/ || $ww > $max_w || !defined $wh || $wh !~ /^[0-9]+$/ || $wh > $max_h) {
          $set_key->("WindowedWidth",  $game_w, 0);
          $set_key->("WindowedHeight", $game_h, 0);
        }
      }

      if ($changed) {
        if ($existed && !-f $backup) {
          if (open my $bf, ">:raw", "$backup.tmp.$$") {
            print $bf $orig;
            close $bf;
            rename "$backup.tmp.$$", $backup;
          }
        }
        my $updated = join($nl, @lines);
        $updated .= $nl if $updated !~ /\Q$nl\E\z/;
        my $tmp = "$path.nr-tmp.$$";
        if (open my $out, ">:raw", $tmp) {
          print $out $updated;
          close $out and rename $tmp, $path or unlink $tmp;
        }
      }

      # Persist per-display state atomically.
      my $stmp = "$state_path.tmp.$$";
      if (open my $so, ">:raw", $stmp) {
        print $so "seeded\t1\n";
        print $so "last\t$screen\t$game_w\t$game_h\t$want_hz\t$cur_gpu\n";
        for my $k (sort keys %displays) {
          my ($dw, $dh, $dhz) = @{$displays{$k}};
          print $so "display\t$k\t$dw\t$dh\t$dhz\n";
        }
        close $so and rename $stmp, $state_path or unlink $stmp;
      }
      print "$game_w $game_h\n";
    ' "$settings_ini" "$backup_ini" "$state_file" "$seed_marker" "$screen_id" "$def_w" "$def_h" "$def_hz" "$max_w" "$max_h" 2>> "$log" || true)
    [ -f "$settings_ini" ] && : > "$seed_marker" 2>/dev/null || true
    set -- $dims
    ow_canvas_w="${1:-$def_w}"
    ow_canvas_h="${2:-$def_h}"
  else
    ow_canvas_w="$def_w"
    ow_canvas_h="$def_h"
  fi
}
[ "$verb" = "waitforexitandrun" ] && seed_overwatch_preferences

if [ "$verb" = "waitforexitandrun" ] && [ -z "${DXMT_CONFIG_FILE:-}" ] && [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
  if is_overwatch_launch; then
    managed_dxmt_conf="$STEAM_COMPAT_DATA_PATH/notrecall-dxmt.conf"
    tmp_dxmt_conf="$managed_dxmt_conf.tmp.$$"
    cpu_brand="${NOTRECALL_TEST_CHIP:-$(/usr/sbin/sysctl -n machdep.cpu.brand_string 2>/dev/null || true)}"
    {
      printf '%s\n' \
        '# Managed by notrecall for Overwatch (Recall tuned DXMT profile)' \
        '[Overwatch.exe]' \
        'd3d11.releaseShaderIR = True' \
        'd3d11.preferredMaxFrameRate = 0' \
        'd3d11.shaderCompilerThreads = 8' \
        'd3d11.shaderCompilerNormalPriority = True' \
        "dxgi.fullscreenCanvasWidth = ${ow_canvas_w:-1920}" \
        "dxgi.fullscreenCanvasHeight = ${ow_canvas_h:-1200}" \
        'dxgi.nativeFullscreen = True' \
        'dxgi.maxFrameLatency = 1' \
        'dxgi.sharpPresentation = True'
      case "$cpu_brand" in
        "Apple A"*)
          printf 'dxgi.displaySyncEnabled = True\n'
          ;;
      esac
      if [ -f "$STEAM_COMPAT_DATA_PATH/dxmt.conf" ]; then
        printf '\n# User overrides from %s\n[Overwatch.exe]\n' "$STEAM_COMPAT_DATA_PATH/dxmt.conf"
        cat "$STEAM_COMPAT_DATA_PATH/dxmt.conf"
        printf '\n'
      fi
    } > "$tmp_dxmt_conf" 2>/dev/null && mv -f "$tmp_dxmt_conf" "$managed_dxmt_conf" 2>/dev/null || rm -f "$tmp_dxmt_conf"
    if [ -f "$managed_dxmt_conf" ]; then
      export DXMT_CONFIG_FILE="$(posix_to_winpath "$managed_dxmt_conf")"
    fi
  elif [ -f "$STEAM_COMPAT_DATA_PATH/dxmt.conf" ]; then
    export DXMT_CONFIG_FILE="$(posix_to_winpath "$STEAM_COMPAT_DATA_PATH/dxmt.conf")"
  fi
fi

# Assemble DXMT_CONFIG clauses without clobbering user-supplied options.
dxmt_cfg="${DXMT_CONFIG:-}"
append_dxmt_cfg() {
  dxmt_cfg="${dxmt_cfg:+$dxmt_cfg;}$1"
}
if [ "${NOTRECALL_FRAME_PACING:-on}" = "on" ]; then
  append_dxmt_cfg "dxgi.presentPacing=True;dxgi.presentPacingMode=3;dxgi.presentPacingTargetUs=1000"
fi
if [ -n "${NOTRECALL_FPS_LIMIT:-}" ] && [ "$NOTRECALL_FPS_LIMIT" != "0" ]; then
  append_dxmt_cfg "d3d11.preferredMaxFrameRate=$NOTRECALL_FPS_LIMIT"
fi
if [ "${DXMT_ENABLE_NVEXT:-0}" = "1" ] && [ -n "${NOTRECALL_METALFX_SHARPNESS:-}" ]; then
  case "$NOTRECALL_METALFX_SHARPNESS" in
    off|0|0.0|0.00) ;;
    low)  append_dxmt_cfg "d3d11.metalfxSharpness=0.4" ;;
    high) append_dxmt_cfg "d3d11.metalfxSharpness=0.8" ;;
    *)    append_dxmt_cfg "d3d11.metalfxSharpness=$NOTRECALL_METALFX_SHARPNESS" ;;
  esac
fi
[ -n "$dxmt_cfg" ] && export DXMT_CONFIG="$dxmt_cfg"

# Stage Recall's signed nvngx.dll into system32 when MetalFX/DLSS is enabled,
# backing up and restoring Wine's placeholder when toggled off.
stage_metalfx_nvngx() {
  [ -n "${WINEPREFIX:-}" ] && [ -n "${STEAM_COMPAT_DATA_PATH:-}" ] || return 0
  sys32="$WINEPREFIX/drive_c/windows/system32"
  [ -d "$sys32" ] || return 0
  src="$nr_runtime/lib/wine/x86_64-windows/nvngx.dll"
  dst="$sys32/nvngx.dll"
  backup="$STEAM_COMPAT_DATA_PATH/notrecall-nvngx.bak"
  marker="$STEAM_COMPAT_DATA_PATH/.notrecall-nvngx.staged"
  if [ "${DXMT_ENABLE_NVEXT:-0}" = "1" ]; then
    [ -f "$src" ] || return 0
    if [ ! -f "$marker" ] && [ -f "$dst" ] && [ ! -f "$backup" ]; then
      cp -f "$dst" "$backup" 2>/dev/null || true
    fi
    if ! cmp -s "$src" "$dst" 2>/dev/null; then
      cp -f "$src" "$dst.nr-tmp" 2>/dev/null && mv -f "$dst.nr-tmp" "$dst" 2>/dev/null || rm -f "$dst.nr-tmp"
    fi
    : > "$marker" 2>/dev/null || true
  elif [ -f "$marker" ]; then
    if [ -f "$backup" ]; then
      cp -f "$backup" "$dst.nr-tmp" 2>/dev/null && mv -f "$dst.nr-tmp" "$dst" 2>/dev/null || rm -f "$dst.nr-tmp"
      rm -f "$backup" 2>/dev/null || true
    else
      rm -f "$dst" 2>/dev/null || true
    fi
    rm -f "$marker" 2>/dev/null || true
  fi
}
[ "$verb" = "waitforexitandrun" ] && stage_metalfx_nvngx

# Sync Overwatch's Settings_v0.ini ([GPU.*] & [Render.13] HighQualityUpsample)
# so toggling MetalFX/DLSS doesn't make Overwatch think the GPU changed and reset video settings.
sync_overwatch_metalfx_settings() {
  is_overwatch_launch || return 0
  [ -n "${WINEPREFIX:-}" ] && [ -n "${STEAM_COMPAT_DATA_PATH:-}" ] || return 0
  [ -x /usr/bin/perl ] || return 0
  settings_ini="$WINEPREFIX/drive_c/users/steamuser/Documents/Overwatch/Settings/Settings_v0.ini"
  [ -f "$settings_ini" ] && [ ! -L "$settings_ini" ] || return 0

  metalfx_on=0
  [ "${DXMT_ENABLE_NVEXT:-0}" = "1" ] && metalfx_on=1
  mac_gpu="${NOTRECALL_TEST_GPU_NAME:-}"
  if [ "$metalfx_on" -eq 0 ] && [ -z "$mac_gpu" ] && [ -x "$nr_helpers/notrecall-sysinfo" ]; then
    mac_gpu=$("$nr_helpers/notrecall-sysinfo" gpu-name 2>/dev/null || true)
  fi
  backup_ini="$STEAM_COMPAT_DATA_PATH/Settings_v0.before-gpu-sync.ini"

  /usr/bin/perl -e '
    my ($path, $backup, $metalfx, $mac_gpu) = @ARGV;
    my $size = -s $path;
    exit 0 if !defined $size || $size > 1048576;
    open my $in, "<:raw", $path or exit 0;
    local $/;
    my $orig = <$in>;
    close $in;
    exit 0 if !defined $orig;
    my $nl = ($orig =~ /\r\n/) ? "\r\n" : "\n";
    my @lines = split(/\Q$nl\E/, $orig, -1);

    my $find_section = sub {
      my ($prefix) = @_;
      my ($s, $e) = (-1, scalar(@lines));
      for my $i (0 .. $#lines) {
        (my $t = $lines[$i]) =~ s/^\s+|\s+$//g;
        if ($s < 0 && index($t, $prefix) == 0) {
          $s = $i + 1;
        } elsif ($s >= 0 && $t =~ /^\[/) {
          return (-1, -1) if index($t, $prefix) == 0;
          $e = $i if $e == scalar(@lines);
        }
      }
      return ($s, $e);
    };

    my $find_key = sub {
      my ($s, $e, $key) = @_;
      for my $i ($s .. $e - 1) {
        (my $t = $lines[$i]) =~ s/^\s+|\s+$//g;
        if ($t =~ /^\Q$key\E\s*=/) {
          return $i;
        }
      }
      return -1;
    };

    my $changed = 0;
    my %card;
    my $apply_card = 0;
    if ($metalfx eq "1") {
      $apply_card = 1;
      %card = (
        GPUName             => "NVIDIA GeForce RTX 4090",
        GPUVenderID         => "4318",
        LastUsedGPUVendorID => "4318",
        GPUDeviceID         => "9860",
        LastUsedGPUDeviceID => "9860",
      );
    } elsif (length $mac_gpu) {
      $apply_card = 1;
      %card = (
        GPUName             => $mac_gpu,
        GPUVenderID         => "4203",
        LastUsedGPUVendorID => "4203",
        GPUDeviceID         => undef,
        LastUsedGPUDeviceID => undef,
      );
    }

    if ($apply_card) {
      my ($gs, $ge) = $find_section->("[GPU.");
      if ($gs >= 0) {
        my $last = $gs;
        for my $i ($gs .. $ge - 1) {
          $last = $i + 1 if $lines[$i] =~ /\S/;
        }
        for my $k (sort keys %card) {
          my $idx = $find_key->($gs, $ge, $k);
          my $val = $card{$k};
          my $line = defined($val) ? "$k = \"$val\"" : undef;
          if ($idx >= 0 && defined($line)) {
            if ($lines[$idx] ne $line) {
              $lines[$idx] = $line;
              $changed = 1;
            }
          } elsif ($idx >= 0 && !defined($line)) {
            splice(@lines, $idx, 1);
            $ge--;
            $last-- if $last > $idx;
            $changed = 1;
          } elsif ($idx < 0 && defined($line)) {
            splice(@lines, $last, 0, $line);
            $last++;
            $ge++;
            $changed = 1;
          }
        }
      }
    }

    if ($metalfx ne "1") {
      my ($rs, $re) = $find_section->("[Render.13]");
      if ($rs >= 0) {
        my $idx = $find_key->($rs, $re, "HighQualityUpsample");
        if ($idx >= 0 && $lines[$idx] =~ /=\s*"3"\s*$/) {
          splice(@lines, $idx, 1);
          $changed = 1;
        }
      }
    }

    exit 0 if !$changed;
    if (!-f $backup) {
      if (open my $bf, ">:raw", "$backup.tmp.$$") {
        print $bf $orig;
        close $bf;
        rename "$backup.tmp.$$", $backup;
      }
    }
    my $updated = join($nl, @lines);
    my $tmp = "$path.nr-tmp.$$";
    open my $out, ">:raw", $tmp or exit 0;
    print $out $updated;
    close $out or do { unlink $tmp; exit 0; };
    rename $tmp, $path or unlink $tmp;
  ' "$settings_ini" "$backup_ini" "$metalfx_on" "$mac_gpu" >> "$log" 2>&1 || true
}
[ "$verb" = "waitforexitandrun" ] && sync_overwatch_metalfx_settings

# Match Recall's explicit DXMT & MetalFX WINEDLLOVERRIDES contract.
vc_overrides=$(native_vc_runtime)
if [ "${DXMT_ENABLE_NVEXT:-0}" = "1" ]; then
  export MTLFX_FORCE_GPU="${MTLFX_FORCE_GPU:-0}"
  metalfx_overrides="d3d12,nvapi64,nvngx=b;"
else
  metalfx_overrides="d3d12,nvapi64,nvngx=;"
fi
export WINEDLLOVERRIDES="${vc_overrides}${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}d3d11,dxgi,d3d10core,winemetal=b;${metalfx_overrides}steamclient=n;steamclient64=n;lsteamclient=b"

# Dynamic Recall raw mouse configuration from the launched .exe basename (or NOTRECALL_MOUSE_EXE).
mouse_mode="${NOTRECALL_MOUSE_MODE:-hid}"
mouse_interval_us=0
case "${NOTRECALL_MOUSE_RATE:-all}" in
  2000) mouse_interval_us=500 ;;
  1000) mouse_interval_us=1000 ;;
  500)  mouse_interval_us=2000 ;;
  250)  mouse_interval_us=4000 ;;
  *)    mouse_interval_us=0 ;;
esac
if [ -n "$exe_name" ] && [ "$mouse_mode" != "off" ]; then
  export WINEMAC_MOUSELOOK="$exe_name"
  case "$mouse_mode" in
    hid)
      export WINEMAC_INPUT_VARIANT="precise"
      export WINEMAC_RAW_SOURCE="hid"
      export WINEMAC_MOUSELOOK_RAW_INTERVAL_US="${WINEMAC_MOUSELOOK_RAW_INTERVAL_US:-$mouse_interval_us}"
      ;;
    precise)
      export WINEMAC_INPUT_VARIANT="precise"
      export WINEMAC_MOUSELOOK_RAW_INTERVAL_US="${WINEMAC_MOUSELOOK_RAW_INTERVAL_US:-$mouse_interval_us}"
      unset WINEMAC_RAW_SOURCE || true
      ;;
    classic)
      export WINEMAC_INPUT_VARIANT="classic"
      unset WINEMAC_RAW_SOURCE || true
      unset WINEMAC_MOUSELOOK_RAW_INTERVAL_US || true
      ;;
  esac
fi

# Per-game DXMT shader pipeline cache path.
# Namespace defaults to ow2-source-v1 to match stock portable-pipeline; per-game
# isolation is already guaranteed by DXMT_PIPELINE_CACHE_PATH under compatdata/<appid>.
cache_root=""
if [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
  cache_root="$STEAM_COMPAT_DATA_PATH/notrecall-cache"
  export DXMT_PIPELINE_CACHE_PATH="$cache_root/cache/pipelines"
  export DXMT_SHADER_CACHE_PATH="${DXMT_SHADER_CACHE_PATH:-$cache_root/cache/shaders}"
  export DXMT_GPU_REPORT="${DXMT_GPU_REPORT:-$STEAM_COMPAT_DATA_PATH/gpu-reports}"
  export DXMT_PIPELINE_CACHE_NAMESPACE="${NOTRECALL_PIPELINE_NAMESPACE:-ow2-source-v1}"
  mkdir -p "$DXMT_PIPELINE_CACHE_PATH" "$DXMT_SHADER_CACHE_PATH" "$DXMT_GPU_REPORT"
  # Honor per-game Rebuild Shaders marker created by NotRecall.app.
  if [ -f "$cache_root/cache/rebuild-shaders" ]; then
    echo "=== rebuild-shaders requested; clearing compiled shader archives and metadata ===" >> "$log" 2>&1 || true
    if [ -n "${DXMT_PIPELINE_CACHE_PATH:-}" ] && [ -d "$DXMT_PIPELINE_CACHE_PATH" ]; then
      for dir in "$DXMT_PIPELINE_CACHE_PATH"/*; do
        [ -d "$dir" ] && [ ! -L "$dir" ] || continue
        # Remove catalog first so the game loads no stale archive if interrupted.
        rm -f -- "$dir/archive.json" 2>/dev/null || true
        rm -rf -- "$dir/archives" 2>/dev/null || true
        rm -f -- "$dir/earlier-macos.json" 2>/dev/null || true
        mkdir -p -- "$dir/archives" 2>/dev/null || true
      done
    fi
    rm -f -- "$cache_root/cache/pack.json" "$cache_root/cache/optimized.json" 2>/dev/null || true
    rm -f -- "$cache_root/cache/rebuild-shaders" 2>/dev/null || true
  fi
  # Recall's pipeline_cache.c reads {"schema":1,"limit":"all"|"first"|<MiB>} from load.json.
  # Write {"schema":1,"limit":"all"} by default to match Recall's applyShaderMemory().
  shader_mem="${NOTRECALL_SHADER_MEM_MB:-all}"
  case "$shader_mem" in
    ""|0|all)
      printf '{"schema":1,"limit":"all"}\n' > "$DXMT_PIPELINE_CACHE_PATH/load.json" 2>/dev/null || true
      ;;
    first)
      printf '{"schema":1,"limit":"first"}\n' > "$DXMT_PIPELINE_CACHE_PATH/load.json" 2>/dev/null || true
      ;;
    *[!0-9]*)
      printf '{"schema":1,"limit":"all"}\n' > "$DXMT_PIPELINE_CACHE_PATH/load.json" 2>/dev/null || true
      ;;
    *)
      printf '{"schema":1,"limit":%s}\n' "$shader_mem" > "$DXMT_PIPELINE_CACHE_PATH/load.json" 2>/dev/null || true
      ;;
  esac
fi

shim_exe="C:\\Program Files (x86)\\Steam\\steam.exe"

# Helper verbs (install scripts, runinprefix) skip Game Mode and pipeline hooks.
if [ "$verb" != "waitforexitandrun" ]; then
  if [ "$prefix_locked" -eq 1 ]; then exec 8>&-; prefix_locked=0; fi
  status=0
  case "$verb" in
    runinprefix) "$WINELOADER" "$@" >> "$log" 2>&1 || status=$? ;;
    *)           "$WINELOADER" "$shim_exe" "$@" >> "$log" 2>&1 || status=$? ;;
  esac
  exit "$status"
fi

# 7. Resolve real game name & optional .icns icon, then build Game Mode .app wrapper.
resolve_game_name() {
  game_name=""
  if [ -n "${STEAM_COMPAT_DATA_PATH:-}" ] && [ "$app_id" != "0" ]; then
    steam_root="$(dirname "$(dirname "$(dirname "$STEAM_COMPAT_DATA_PATH")")")"
    manifest="$steam_root/steamapps/appmanifest_$app_id.acf"
    if [ -f "$manifest" ]; then
      game_name=$(sed -n 's/.*"name"[[:space:]]*"\(.*\)".*/\1/p' "$manifest" | head -1)
    fi
  fi
  [ -z "$game_name" ] && [ -n "${STEAM_COMPAT_INSTALL_PATH:-}" ] && game_name=$(basename "$STEAM_COMPAT_INSTALL_PATH")
  [ -z "$game_name" ] && game_name="NotRecall Game ($app_id)"
  game_name_xml=$(printf '%s' "$game_name" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
}

launch_wine="$WINELOADER"
game_app=""
# Recall's ntdll.so implements WINE_GAME_MODE (game_mode_exec) BEFORE CrossOver's
# CW HACK 22144 symlink hack: when WINE_GAME_MODE=Overwatch.exe is set and
# runtime/lib/wine/game-mode/Overwatch.app exists, Wine automatically execs the
# signed Overwatch.app bundle for Overwatch.exe so macOS turns Game Mode on.
recall_ow_app="$nr_runtime/lib/wine/game-mode/Overwatch.app"
if [ "${NOTRECALL_GAME_MODE:-1}" != "0" ] && is_overwatch_launch && [ -x "$recall_ow_app/Contents/MacOS/wine" ]; then
  export WINE_GAME_MODE="Overwatch.exe"
  game_app="$recall_ow_app"
elif [ "${NOTRECALL_GAME_MODE:-1}" != "0" ] && [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
  resolve_game_name
  launcher_dir="$nr_support/launchers/$app_id"
  game_app="$launcher_dir/NotRecallGame.app"
  stamp_file="$launcher_dir/.notrecall-stamp"

  # Rewrite LC_UUID deterministically per AppID so macOS Local Network privacy
  # keys each Steam game separately (matching Recall's game_mode_app.py).
  patch_macho_uuid() {
    [ -x /usr/bin/perl ] || return 0
    /usr/bin/perl -MDigest::SHA=sha1 -e '
      my ($path, $ident) = @ARGV;
      open my $fh, "+<:raw", $path or exit 1;
      read($fh, my $hdr, 32) == 32 or exit 1;
      my ($magic, undef, undef, undef, $ncmds) = unpack("V5", $hdr);
      exit 0 if $magic != 0xfeedfacf;
      my $off = 32;
      for (1 .. $ncmds) {
        seek($fh, $off, 0) or exit 1;
        read($fh, my $lc, 8) == 8 or exit 1;
        my ($cmd, $cmdsize) = unpack("VV", $lc);
        last if $cmdsize < 8;
        if ($cmd == 0x1b && $cmdsize >= 24) {
          read($fh, my $orig, 16) == 16 or exit 1;
          my @b = unpack("C16", substr(sha1($orig . $ident), 0, 16));
          $b[6] = ($b[6] & 0x0f) | 0x50;
          $b[8] = ($b[8] & 0x3f) | 0x80;
          seek($fh, $off + 8, 0) or exit 1;
          print $fh pack("C16", @b);
          close $fh;
          exit 0;
        }
        $off += $cmdsize;
      }
      close $fh;
    ' "$1" "$2" 2>/dev/null || true
  }

  wrapper_schema="v3"
  wine_sha=$(/usr/bin/shasum -a 256 "$WINELOADER" | cut -d' ' -f1)
  if [ -f "$nr_runtime/runtime.json" ]; then
    runtime_sig=$(/usr/bin/shasum -a 256 "$nr_runtime/runtime.json" | cut -d' ' -f1)
  elif [ -d "$wine_unix" ]; then
    runtime_sig=$(LC_ALL=C ls -1i "$wine_unix" | /usr/bin/shasum -a 256 | cut -d' ' -f1)
  else
    runtime_sig="none"
  fi
  wrapper_stamp="${wrapper_schema}|${wine_sha}|${runtime_sig}|${nr_runtime}|${wine_unix}|${game_name}"

  saved_stamp=""
  if [ -f "$stamp_file" ]; then
    saved_stamp=$(cat "$stamp_file" 2>/dev/null) || saved_stamp=""
  fi

  needs_rebuild=0
  if [ ! -x "$game_app/Contents/MacOS/wine" ] || [ ! -L "$game_app/Contents/lib" ] || [ ! -d "$game_app/Contents/lib" ] || [ "$saved_stamp" != "$wrapper_stamp" ]; then
    needs_rebuild=1
  fi
  if [ "$needs_rebuild" -eq 1 ]; then
    mkdir -p "$game_app/Contents/MacOS" "$game_app/Contents/Resources"
    cp -c "$WINELOADER" "$game_app/Contents/MacOS/wine" 2>/dev/null || cp "$WINELOADER" "$game_app/Contents/MacOS/wine"
    chmod u+w "$game_app/Contents/MacOS/wine" 2>/dev/null || true
    patch_macho_uuid "$game_app/Contents/MacOS/wine" "io.shreyash.notrecall.game.$app_id"
    # Preserve Recall's @loader_path/../lib LC_RPATH from Contents/MacOS/wine.
    ln -sfn "$nr_runtime/lib" "$game_app/Contents/lib" 2>/dev/null || true
    # CrossOver 26's wine looks for ntdll.so and unix libs right next to itself.
    for f in "$wine_unix"/*; do
      [ -e "$f" ] || continue
      base=${f##*/}
      case "$base" in wine|wine.app) continue ;; esac
      ln -sfn "$f" "$game_app/Contents/MacOS/$base" 2>/dev/null || true
    done
    # Try building a Dock icon via NotProton's iconmaker if available.
    icon_arg=""
    if [ -x "$np_support/iconmaker" ] && [ -n "$target" ] && [ -f "$target" ]; then
      if "$np_support/iconmaker" "$target" "$game_app/Contents/Resources/game.icns" >> "$log" 2>&1; then
        icon_arg="  <key>CFBundleIconFile</key><string>game</string>"
      fi
    fi
    cat > "$game_app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>$game_name_xml</string>
  <key>CFBundleDisplayName</key><string>$game_name_xml</string>
  <key>CFBundleIdentifier</key><string>io.shreyash.notrecall.game.$app_id</string>
  <key>CFBundleExecutable</key><string>wine</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSSupportsGameMode</key><true/>
  <key>GCSupportsGameMode</key><true/>
  <key>LSApplicationCategoryType</key><string>public.app-category.games</string>
  <key>NSMicrophoneUsageDescription</key><string>This game would like to access your microphone.</string>
  <key>NSLocalNetworkUsageDescription</key><string>This game would like to access devices on your local network.</string>
$icon_arg
</dict>
</plist>
PLIST
    # Ad-hoc sign the wrapper bundle preserving wine's entitlements so Game Mode & TCC bind cleanly,
    # while allowing DYLD_* env vars (Steam Overlay / overlay-shim.dylib) under Hardened Runtime.
    ent_tmp=$(mktemp "${TMPDIR:-/tmp}/notrecall-ent.XXXXXX" 2>/dev/null || true)
    ent_ok=0
    if [ -n "$ent_tmp" ] && /usr/bin/codesign -d --xml --entitlements - "$WINELOADER" > "$ent_tmp" 2>/dev/null && grep -q '<key>' "$ent_tmp" 2>/dev/null; then
      ent_ok=1
      for ent_key in \
        com.apple.security.cs.allow-dyld-environment-variables \
        com.apple.security.cs.disable-library-validation; do
        if ! /usr/libexec/PlistBuddy -c "Set :$ent_key true" "$ent_tmp" >/dev/null 2>&1; then
          if ! /usr/libexec/PlistBuddy -c "Add :$ent_key bool true" "$ent_tmp" >/dev/null 2>&1; then
            ent_ok=0
            break
          fi
        fi
      done
    fi
    sign_ok=0
    if [ "$ent_ok" -eq 1 ]; then
      if /usr/bin/codesign --force --options runtime --sign - --entitlements "$ent_tmp" "$game_app" >> "$log" 2>&1; then
        sign_ok=1
      elif /usr/bin/codesign --force --sign - "$game_app" >> "$log" 2>&1; then
        sign_ok=1
      fi
    else
      if /usr/bin/codesign --force --sign - "$game_app" >> "$log" 2>&1; then
        sign_ok=1
      fi
    fi
    if [ -n "$ent_tmp" ]; then
      rm -f "$ent_tmp"
    fi
    touch "$game_app/Contents/MacOS" 2>/dev/null || true
    if [ "$sign_ok" -eq 1 ]; then
      printf '%s\n' "$wrapper_stamp" > "$stamp_file.tmp"
      mv -f "$stamp_file.tmp" "$stamp_file"
    else
      echo "=== warning: codesign failed for $game_app; will retry on next launch ===" >> "$log" 2>&1 || true
      rm -f "$stamp_file" "$stamp_file.tmp"
    fi
    /System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Support/lsregister -f "$game_app" >> "$log" 2>&1 || true
  fi
  launch_wine="$game_app/Contents/MacOS/wine"
fi

if [ "$prefix_locked" -eq 1 ]; then exec 8>&-; prefix_locked=0; fi

# 8. Pre-launch shader pipeline consolidate & warm.
pipeline_hook="$nr_helpers/pipeline_hook.sh"
[ ! -x "$pipeline_hook" ] && [ -x "$tool_dir/pipeline_hook.sh" ] && pipeline_hook="$tool_dir/pipeline_hook.sh"
if [ -n "$cache_root" ] && [ -x "$pipeline_hook" ]; then
  "$pipeline_hook" pre "$cache_root" "${game_app:-$launch_wine}" "$log" || true
fi

# 9. Wire Steam Overlay shim and launch game through steam.exe shim.
inserts="${STEAM_DYLD_INSERT_LIBRARIES:-}"
overlay_shim="$np_support/overlay-shim.dylib"
if [ -n "$inserts" ] && [ -f "$overlay_shim" ]; then
  export NOTPROTON_OVERLAY_SHIM="$overlay_shim"
  inserts="$overlay_shim:$inserts"
fi

child_pid=""
terminated=0
cleanup() {
  terminated=1
  echo "=== termination signal received, shutting down wineserver ===" >> "$log" 2>&1 || true
  "$WINESERVER" -k >> "$log" 2>&1 || true
  "$WINESERVER" -w >> "$log" 2>&1 || true
  if [ -n "$child_pid" ]; then
    kill "$child_pid" 2>/dev/null || true
  else
    exit 143
  fi
}
trap cleanup TERM INT HUP

{
  echo "=== launching: $launch_wine $shim_exe $* ==="
  echo "DXMT_CONFIG_FILE=${DXMT_CONFIG_FILE:-} DXMT_CONFIG=${DXMT_CONFIG:-}"
  echo "WINEMAC_MOUSELOOK=${WINEMAC_MOUSELOOK:-} WINEMAC_RAW_SOURCE=${WINEMAC_RAW_SOURCE:-} WINEMAC_MOUSELOOK_RAW_INTERVAL_US=${WINEMAC_MOUSELOOK_RAW_INTERVAL_US:-}"
} >> "$log" 2>&1 || true

(
  export WINELOADER="$launch_wine"
  [ -z "$inserts" ] || export DYLD_INSERT_LIBRARIES="$inserts"
  exec "$launch_wine" "$shim_exe" "$@"
) >> "$log" 2>&1 &
child_pid=$!

status=0
wait "$child_pid" || status=$?
if [ "$terminated" -eq 0 ]; then
  echo "=== game exited (status=$status), stopping wineserver ===" >> "$log" 2>&1 || true
  "$WINESERVER" -k >> "$log" 2>&1 || true
  "$WINESERVER" -w >> "$log" 2>&1 || true
fi

# 10. Kick off detached post-session shader precompilation.
if [ -n "$cache_root" ] && [ -x "$pipeline_hook" ]; then
  "$pipeline_hook" post "$cache_root" "${game_app:-$launch_wine}" "$log" || true
fi

exit "$status"
